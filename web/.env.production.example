# Production build configuration for the web app. Copy to `.env.production`
# (gitignored) OR set these as environment variables on the hosting platform
# (Netlify/Vercel). Injected at BUILD time by Vite. The anon key is publishable
# (protected by Row Level Security) — it ships in the bundle by design.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: error tracking. Leave empty to disable Sentry.
VITE_SENTRY_DSN=

# Suppresses the dev error overlay in production builds.
VITE_DISABLE_ERROR_OVERLAY=true
