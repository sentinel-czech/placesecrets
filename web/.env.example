# place-secrets admin web — environment template
# Copy to .env.local (gitignored) and fill in real values for your environment.
# Never commit real keys. Only the anon (public) key belongs in the client bundle;
# the service_role / Stripe secret keys must stay server-side (Supabase Edge Functions).

# Supabase project URL (local default shown)
VITE_SUPABASE_URL=http://localhost:54321

# Supabase ANON (public) key — safe to ship to the browser. NOT the service_role key.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
